# -------------------------------------------------
# Laravel
# -------------------------------------------------
/vendor
/node_modules
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/bootstrap/ssr

# -------------------------------------------------
# Build Output
# -------------------------------------------------
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# -------------------------------------------------
# Storage
# -------------------------------------------------
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail

# Optional uploads (if not versioned)
/public/uploads

# -------------------------------------------------
# Environment
# -------------------------------------------------
.env
.env.*
!.env.example
.envrc

# -------------------------------------------------
# PHPUnit / Pest
# -------------------------------------------------
.phpunit.cache
.phpunit.result.cache
coverage/
coverage.xml

# -------------------------------------------------
# Composer
# -------------------------------------------------
/auth.json
composer.phar

# -------------------------------------------------
# JavaScript
# -------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Keep lock files committed for reproducible builds
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# -------------------------------------------------
# Generated Inertia / Wayfinder
# -------------------------------------------------
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder

# -------------------------------------------------
# IDEs
# -------------------------------------------------
.idea/
.vscode/
.fleet/
.zed/
.nova/

# -------------------------------------------------
# PHP Tools
# -------------------------------------------------
.phpactor.json
.php-cs-fixer.cache
.phpstan.cache
.phpstan/
.psalm/
rector-cache/
rector.php.cache

# -------------------------------------------------
# Laravel Herd / Valet
# -------------------------------------------------
.herd
.valet

# -------------------------------------------------
# Docker
# -------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml

# -------------------------------------------------
# Homestead
# -------------------------------------------------
Homestead.json
Homestead.yaml

# -------------------------------------------------
# Operating System
# -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

